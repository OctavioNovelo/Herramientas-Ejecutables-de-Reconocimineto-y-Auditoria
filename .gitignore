# Resultados de escaneo: datos de redes reales (IPs, MACs, servicios, vulnerabilidades).
# NUNCA deben subirse. Aquí viven todos los .xml/.txt que genera tools/nmap.py.
utils/Resultados/

# Nuclei: el binario (~140 MB) supera el límite de GitHub (100 MB) y las plantillas (~86 MB,
# ~14 mil archivos) cambian cada semana; Nuclei las instala solo en su primera ejecución.
# Ver tools/README.md para descargarlo.
tools/tools_bin/*/Nuclei/nuclei
tools/tools_bin/*/Nuclei/nuclei.exe
tools/tools_bin/*/Nuclei/*.descarga
tools/tools_bin/nuclei-templates/

# Python
__pycache__/
# Solo bytecode: los .pyd SÍ se versionan (módulos nativos del Nmap/Zenmap de Windows en tools_bin/).
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node / Vite
# package-lock.json SÍ se versiona: fija las versiones exactas de las dependencias.
frontend/node_modules/
frontend/dist/
npm-debug.log*

# Rust / Tauri
frontend/src-tauri/target/
frontend/src-tauri/gen/schemas/

# Variables de entorno y secretos
.env
.env.*
# Excepción: modos de demostración de Vite (sin secretos, ver frontend/package.json → tauri:demo)
!frontend/.env.demo
!frontend/.env.demovacio

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
