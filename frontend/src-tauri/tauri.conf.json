{
  "productName": "HERA",
  "version": "1.0.0",
  "identifier": "com.hera.network-audit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HERA - Network Reconnaissance",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ]
  },
  "plugins": {
    "info": {
      "archivo": "frontend/src-tauri/tauri.conf.json",
      "razon": "Define la configuración nativa de la ventana (tamaño, redimensionable) y los scripts de integración con Vite y Rust."
    }
  }
}
